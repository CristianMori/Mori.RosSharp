<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mori.RosSharp</RootNamespace>

    <PackageId>Mori.RosSharp</PackageId>
    <Version>1.1.0</Version>
    <Description>A ROS 1 node in pure managed C#: XML-RPC graph APIs and TCPROS transport on raw sockets, with .msg-driven serialization — a bundled source generator turns .msg AdditionalFiles into typed classes at build time, or serialize dynamically at runtime. No native dependencies, no bridge.</Description>
    <Authors>Cristian Mori</Authors>
    <Copyright>© 2026 Cristian Mori</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>ros;ros1;tcpros;robotics;xmlrpc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: the RosWriter/RosReader primitive overloads are self-describing. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- The .msg parser / md5 engine is shared source with the generator tools (which cannot
         reference a net8.0 assembly), so it is compiled into each project from shared\. -->
    <Compile Include="..\..\shared\*.cs" LinkBase="Msg" />
  </ItemGroup>

  <!-- The source generator ships inside this package (analyzers/, next to lib/): one
       PackageReference brings the runtime and build-time .msg codegen together. -->
  <ItemGroup>
    <ProjectReference Include="..\Mori.RosSharp.Generators\Mori.RosSharp.Generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Mori.RosSharp.Generators\bin\$(Configuration)\netstandard2.0\Mori.RosSharp.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Mori.RosSharp.Generators\buildTransitive\Mori.RosSharp.Generators.props"
          Pack="true" PackagePath="buildTransitive/Mori.RosSharp.props" />
  </ItemGroup>

  <!-- Intentionally dependency-free and cross-platform: a ROS 1 node is XML-RPC over HTTP plus
       TCPROS framing, both implemented here on raw sockets and System.Xml. -->

</Project>
